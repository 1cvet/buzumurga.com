
# Блокировка нежелательных IP-адресов и диапазонов
<RequireAll>
    Require all granted
    Require not ip 213.171.8.0/24
    Require not ip 31.173.80.0/24
    Require not ip 81.222.178.0/24
    Require not ip 94.25.169.0/24
    Require not ip 94.25.175.0/24
    Require not ip 109.197.206.0/24
    Require not ip 178.176.75.0/24
    Require not ip 188.65.244.0/24
    Require not ip 213.87.136.0/24
    Require not ip 213.87.148.0/24
    Require not ip 213.87.149.0/24
    Require not ip 2a04:c105::/32
    Require not ip 2a04:5200:ffff::/48
    Require not ip 2a07:14c0:1:919::/64
    Require not ip 2a09:6906:edbd:1365::/64
    Require not ip 2a09:e5c0::/32
    Require not ip 2a0b:1586::/32
    Require not ip 2a0c:6901::/32
    Require not ip 2a0d:8b01::/32
    Require not ip 2a0e:e5c0::/32
    Require not ip 2a11:a86::/32
    Require not ip 2a11:c84::/32
    Require not ip 2a12:7c00::/32
    Require not ip 2a12:c301::/32
</RequireAll>

# ----------------------------------------------------------------------
# Защита служебных файлов
# ----------------------------------------------------------------------
<FilesMatch "^\.|\.(md|log|json)$">
    Require all denied
</FilesMatch>
<Files "readme.txt">
    Require all denied
</Files>

ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Кодировка и сжатие
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Кэширование статики в браузере
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# ----------------------------------------------------------------------
# Заголовки безопасности
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
